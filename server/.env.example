# Copy this file to .env and fill in your own local values.
# Never commit .env - it holds real credentials.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/toktickit_dev?schema=public"

# Port the Express API listens on.
PORT=3001

# Origin allowed by CORS (the Vite dev server).
CLIENT_ORIGIN="http://localhost:5173"
