// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  createdAt   DateTime @default(now())

  // Inverse side of Ticket.category, required by Prisma's relation
  // validation. No new column on Category; the FK lives on Ticket.
  tickets Ticket[]
}

// Lab 2's `Requester` table, renamed in place rather than replaced (see
// specification.md 7.2). Every Ticket keeps pointing at the same rows through
// the same foreign key, so the migration cannot move ownership even by mistake.
model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(REQUESTER)
  isActive           Boolean  @default(true)
  // Default true: every account is born holding a password somebody else chose,
  // whether it came from the seed or from an Administrator (BR-02).
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Two relations between the same pair of models, so both need names.
  ticketsRequested Ticket[] @relation("TicketRequester")
  ticketsOwned     Ticket[] @relation("TicketOwner")

  comments TicketComment[]
  sessions Session[]
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// An opaque server-side session (BR-09). What is stored is sha256 of the
// token, never the token: a dump of this table then yields nothing anyone can
// present as a cookie. sha256 rather than bcrypt because the lookup is by
// exact value on every authenticated request - a slow hash cannot be looked
// up, only compared, and the token is 32 random bytes so there is nothing to
// brute-force.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Logout-all, deactivation, and a new initial password all delete by user.
  @@index([userId])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Declaration order is load-bearing: Postgres sorts a native enum by the
// order its values are declared, not alphabetically, so `requestedPriority
// desc` yields HIGH -> MEDIUM -> LOW purely because of the sequence below.
// AC-16 depends on that. Reordering these values silently changes the sort;
// my-tickets.api.test.ts asserts the resulting order so it cannot happen
// unnoticed.
enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

// Extended in Lab 3, appending only: NEW keeps position 0, so no existing row
// changes meaning and Postgres's declaration-order sort stays predictable.
// Permitted movement between these values is the matrix in specification.md 5.2,
// enforced in lib/status-transitions.ts - the enum says what a status can be,
// never what it may become.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// IT Priority is the operational judgement and carries a level above the
// Requester-facing ceiling (specification.md 11). Declaration order is
// load-bearing here for the same reason it is on RequestedPriority: AC-25 wants
// URGENT -> HIGH -> MEDIUM -> LOW from a plain `itPriority desc`.
enum ItPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

model Ticket {
  id                  Int               @id @default(autoincrement())
  ticketNumber        String            @unique
  // Deliberately still named requesterId: renaming it would rewrite every
  // existing row's foreign key for cosmetic benefit (specification.md 7.2).
  requesterId         Int
  requester           User              @relation("TicketRequester", fields: [requesterId], references: [id])
  // Null means unassigned. Constrained to active IT Staff or Administrators by
  // BR-19, which is an application rule: the database cannot express "a User
  // whose role is one of two values".
  ownerId             Int?
  owner               User?             @relation("TicketOwner", fields: [ownerId], references: [id])
  categoryId          Int
  category            Category          @relation(fields: [categoryId], references: [id])
  relatedSystemId     Int
  relatedSystem       RelatedSystem     @relation(fields: [relatedSystemId], references: [id])
  summary             String
  description         String
  requestedPriority   RequestedPriority
  // Initialised from requestedPriority at creation, then owned by IT Staff
  // (BR-21). The two are separate columns so the screen can show what was asked
  // for beside what was decided.
  itPriority          ItPriority
  currentStatus       TicketStatus      @default(NEW)
  // The Requester's "this looks fixed" signal (BR-24). Never a status: only IT
  // Staff resolve or close a Ticket.
  requesterResolvedAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  attachments Attachment[]
  comments    TicketComment[]

  @@index([requesterId])
  // Both are queue filters (BR-30), and the queue reads every Ticket in the
  // system rather than one Requester's slice.
  @@index([ownerId])
  @@index([currentStatus])
}

// One model for both Public Comments and Internal Notes, separated by
// visibility (specification.md 11). BR-04 is then a single filter applied in one
// place rather than two code paths that can drift apart.
model TicketComment {
  id         Int               @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket            @relation(fields: [ticketId], references: [id])
  authorId   Int
  author     User              @relation(fields: [authorId], references: [id])
  visibility CommentVisibility
  body       String
  createdAt  DateTime          @default(now())

  // Always read per ticket, and a Requester's read filters visibility as well.
  @@index([ticketId, visibility])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket    @relation(fields: [ticketId], references: [id])
  originalFilename String
  storedFilename   String    @unique
  mimeType         String
  sizeBytes        Int
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removedReason    String?
  createdAt        DateTime  @default(now())

  @@index([ticketId])
}
